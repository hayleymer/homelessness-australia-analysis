    <worksheet name='National Demand'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Unmet demand has grown 50% while people receiving help has remained consistent</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Unique clients assisted vs. requests not met, national total, 2017–18 to 2024–25 (AIHW)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Unassisted requests spiked sharply twice: +21.8 points in 2020-21, then +22.2 points in 2024-25, the two steepest single-year rises in the series. Between them, 2021-22 saw a partial pullback of −10.4 points. Unique clients assisted moved within a narrow 6-point band across the entire period, never approaching the scale of movement seen in unassisted requests.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/aihw_homeless_in_australia_review_August_2026/NationalDemand?rev=' id='132698415' path='/workbooks/aihw_homeless_in_australia_review_August_2026' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='hist_national_demand' name='federated.1a5b4w316mj1h315wmbt80ycjo2c' />
          </datasources>
