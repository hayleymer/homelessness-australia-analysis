    <worksheet name='State Demand'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>In some states, more than half of all requests for help go unmet</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Share of requests not met, by state, 2024–25. Rates reflect service capacity, not decisions to refuse (AIHW)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Bars are sorted by current level, not by growth: Northern Territory (+13.3 points) and Queensland (+12.2 points) have risen most since 2017–18, though neither is highest today. South Australia&apos;s low figure understates its true unmet demand — AIHW notes its service model records fewer unassisted requests, and South Australia does not read its low number as lower need.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/aihw_homeless_in_australia_review_August_2026/StateDemand?rev=' id='132698419' path='/workbooks/aihw_homeless_in_australia_review_August_2026' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='hist_state_unmet_rate' name='federated.1e7wqla1mcq31y1cth25f09517jd' />
          </datasources>
